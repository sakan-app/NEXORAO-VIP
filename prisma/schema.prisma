generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  priceCents       Int
  currency         String           @default("EUR")
  stock            Int              @default(0)
  active           Boolean          @default(true)
  // Storefront category id (index.html categoryConfig), description and pictures.
  category         String?
  description      String?
  imageUrl         String?
  images           String[]         @default([])
  // CJ Dropshipping source: product id, supplier price and cheapest shipping to Germany (USD).
  cjPid            String?          @unique
  supplierPriceUsd Decimal?         @db.Decimal(12, 2)
  shippingUsd      Decimal?         @db.Decimal(12, 2)
  // Option names in CJ order, e.g. ["Color", "Size"].
  variantDims      String[]         @default([])
  variants         ProductVariant[]
  items            OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([active])
  @@index([category, active])
}

// One orderable CJ variant (size/colour) with its own sale price.
model ProductVariant {
  id               String      @id @default(uuid()) @db.Uuid
  productId        String      @db.Uuid
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cjVid            String      @unique
  sku              String?
  options          Json
  size             String?
  color            String?
  supplierPriceUsd Decimal     @db.Decimal(12, 2)
  priceCents       Int
  imageUrl         String?
  weightG          Int?
  active           Boolean     @default(true)
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([productId, active])
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String      @default("PENDING")
  totalCents      Int
  currency        String      @default("EUR")
  shippingAddress Json
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, createdAt])
}

model OrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @db.Uuid
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String          @db.Uuid
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?         @db.Uuid
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPriceCents Int
}
